# Copy this file to .env and fill in whichever providers you've signed up for.
# .env is gitignored - never commit real keys.
#
# Tried in this order (see app/llm/client.py for why): Groq doesn't train
# on free-tier inputs; Gemini and Mistral do, by default.
# A provider with no key set here is skipped, not treated as an error.

GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
